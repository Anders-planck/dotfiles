# Template for ~/.config/zsh/secrets.zsh — sourced from the end of ~/.zshrc.
#
# Setup:
#   mkdir -p ~/.config/zsh && chmod 700 ~/.config/zsh
#   cp .config/zsh/secrets.zsh.example ~/.config/zsh/secrets.zsh
#   chmod 600 ~/.config/zsh/secrets.zsh
#
# Never commit the real file. `.gitignore` already excludes secrets.zsh, but the
# safest habit is to keep it outside any repo entirely — which is why it lives in
# ~/.config/zsh and not in this checkout.
#
# Rationale: these used to be plain `export` lines inside ~/.zshrc, which is
# mode 0644 — readable by every process and user on the machine.

# export GITHUB_PERSONAL_ACCESS_TOKEN=""
# export ANTHROPIC_API_KEY=""
# export OPENAI_API_KEY=""
