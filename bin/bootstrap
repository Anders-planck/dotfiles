#!/usr/bin/env sh
# Install the CLI tools the zsh config probes for, then verify them.
#
# Usage:
#   ./bootstrap             install what is missing
#   ./bootstrap --dry-run   only report what would be installed
#   ./bootstrap --check     only verify, install nothing
#
# Idempotent: tools already on PATH are skipped.
#
# Why this exists: every fragment in .zsh/ is guarded by `type <tool>`, so a
# missing tool degrades silently. That is how EDITOR ended up pointing at a
# `micro` binary that was never installed.
set -eu

mode=install
case "${1:-}" in
	--dry-run) mode=dry ;;
	--check) mode=check ;;
	-h | --help)
		sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	'') ;;
	*)
		printf 'unknown option: %s\n' "$1" >&2
		exit 2
		;;
esac

# command:formula — the formula name differs from the command for git-delta.
# fzf is deliberately absent: zsh4humans installs and manages its own copy in
# $Z4H/fzf/bin, and a second one on PATH shadows it.
TOOLS='bat:bat
broot:broot
btop:btop
delta:git-delta
difft:difftastic
duf:duf
dust:dust
eza:eza
fastfetch:fastfetch
fd:fd
fortune:fortune
hyperfine:hyperfine
jq:jq
micro:micro
procs:procs
rg:ripgrep
sd:sd
tldr:tealdeer
tmux:tmux
tree:tree
yazi:yazi
zoxide:zoxide'

missing=''
present=''
for pair in $TOOLS; do
	cmd=${pair%%:*}
	formula=${pair#*:}
	if command -v "$cmd" >/dev/null 2>&1; then
		present="$present $cmd"
	else
		missing="$missing $formula"
		printf 'missing  %-10s (brew formula: %s)\n' "$cmd" "$formula"
	fi
done

[ -n "$present" ] && printf 'present ->%s\n' "$present"

if [ -z "$missing" ]; then
	printf '\nAll tools present. Nothing to do.\n'
else
	printf '\nMissing:%s\n' "$missing"
	case "$mode" in
		check | dry)
			printf 'Run without --dry-run/--check to install them.\n'
			;;
		install)
			if ! command -v brew >/dev/null 2>&1; then
				printf '\nHomebrew is not installed. Install it first:\n' >&2
				printf '  https://brew.sh\n' >&2
				printf '(Deliberately not piping an installer from the network here.)\n' >&2
				exit 1
			fi
			# shellcheck disable=SC2086
			brew install $missing
			;;
	esac
fi

printf '\n--- verification ---\n'
rc=0
for pair in $TOOLS; do
	cmd=${pair%%:*}
	if path=$(command -v "$cmd" 2>/dev/null); then
		printf 'ok       %-10s %s\n' "$cmd" "$path"
	else
		printf 'MISSING  %-10s\n' "$cmd"
		rc=1
	fi
done

# Things the config depends on that Homebrew does not cover.
printf '\n--- config checks ---\n'
if [ -n "${Z4H:-}" ] || [ -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh4humans/v5" ]; then
	printf 'ok       zsh4humans cache present\n'
else
	printf 'note     zsh4humans not bootstrapped yet — start a new shell once\n'
fi

if [ -r "$HOME/.config/zsh/secrets.zsh" ]; then
	perm=$(stat -f '%Lp' "$HOME/.config/zsh/secrets.zsh" 2>/dev/null ||
		stat -c '%a' "$HOME/.config/zsh/secrets.zsh" 2>/dev/null || echo '?')
	if [ "$perm" = "600" ]; then
		printf 'ok       secrets.zsh mode 0600\n'
	else
		printf 'WARN     secrets.zsh mode %s — should be 600: chmod 600 %s\n' \
			"$perm" "$HOME/.config/zsh/secrets.zsh"
		rc=1
	fi
else
	printf 'note     no ~/.config/zsh/secrets.zsh (fine if you keep no tokens)\n'
fi

if command -v mise >/dev/null 2>&1; then
	printf 'ok       mise -> %s\n' "$(mise --version 2>/dev/null | head -1)"
	mise ls --current 2>/dev/null | sed 's/^/         /'
else
	printf 'WARN     mise not installed — node/ruby versions will not resolve\n'
	rc=1
fi

exit $rc
