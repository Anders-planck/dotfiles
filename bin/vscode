#!/usr/bin/env bash
# Sync VS Code configuration between this repo and the live install.
#
#   bin/vscode export   copy the live config into the repo (sanitising secrets)
#   bin/vscode apply    copy the repo config over the live one
#   bin/vscode status   show what differs
#
# VS Code on macOS is not XDG: its User directory lives under
# ~/Library/Application Support/Code/User. The files are not symlinked, because
# VS Code rewrites settings.json itself whenever you change a setting in the UI
# and would fight a symlink into the repo. Hence explicit export/apply.
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
src="$repo/vscode"
user="$HOME/Library/Application Support/Code/User"

# settings.json and keybindings.json round-trip. mcp.json does NOT: it carries
# live Bearer tokens for Sanity and Neon, so only a sanitised .example is kept.
FILES=(settings.json keybindings.json)

usage() {
	sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

sanitise_mcp() {
	[ -f "$user/mcp.json" ] || return 0
	# Redact by VALUE across the whole document, not by one known key.
	# The previous version rewrote only servers[*].headers.Authorization, so a
	# server authenticating through `env`, `args`, a token in the url, an
	# X-Api-Key header or inputs[].default was published verbatim — and the
	# committed file is the one that reaches a public repo.
	#
	# Written to a temp file and scanned there: on failure nothing lands in the
	# repo, where a later `git add -A` would sweep it up.
	local tmp
	tmp=$(mktemp) || return 1
	python3 - "$user/mcp.json" "$tmp" <<-'PY'
		import json, re, sys

		# Known credential prefixes, plus a generic high-entropy fallback.
		PREFIXES = re.compile(
		    r"(gh[pousr]_[A-Za-z0-9]{16,}"
		    r"|github_pat_[A-Za-z0-9_]{20,}"
		    r"|sk-[A-Za-z0-9_-]{16,}"
		    r"|sk_(live|test)_[A-Za-z0-9]{16,}"
		    r"|glpat-[A-Za-z0-9_-]{16,}"
		    r"|xox[baprs]-[A-Za-z0-9-]{10,}"
		    r"|AKIA[0-9A-Z]{16}"
		    r"|AIza[0-9A-Za-z_-]{20,}"
		    r"|ey[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})"
		)
		# Key names whose value is a credential whatever it looks like.
		SECRET_KEY = re.compile(
		    r"(authorization|api[-_]?key|secret|token|password|passwd|credential|bearer)",
		    re.I,
		)
		PLACEHOLDER = "${input:REPLACE_ME}"
		hits = []

		def looks_secret(v):
		    if not isinstance(v, str) or len(v) < 16:
		        return False
		    if PREFIXES.search(v):
		        return True
		    # Long opaque blob with no spaces: treat as a credential.
		    body = v[7:] if v.lower().startswith("bearer ") else v
		    return len(body) >= 24 and " " not in body and re.fullmatch(r"[A-Za-z0-9._~+/=-]+", body) is not None

		def scrub(node, path="", key=None):
		    if isinstance(node, dict):
		        return {k: scrub(v, f"{path}.{k}", k) for k, v in node.items()}
		    if isinstance(node, list):
		        return [scrub(v, f"{path}[{i}]", key) for i, v in enumerate(node)]
		    if isinstance(node, str):
		        if (key and SECRET_KEY.search(key)) or looks_secret(node):
		            hits.append(path)
		            return PLACEHOLDER
		        # A token embedded in a URL query string.
		        if "://" in node and PREFIXES.search(node):
		            hits.append(path)
		            return PREFIXES.sub(PLACEHOLDER, node)
		    return node

		out = scrub(json.load(open(sys.argv[1])))
		open(sys.argv[2], "w").write(json.dumps(out, indent=2) + "\n")
		print(len(hits))
		for h in hits:
		    print("    redacted " + h.lstrip("."), file=sys.stderr)
	PY

	# Independent check on the sanitised file, before it goes anywhere near the repo.
	if grep -qEi 'gh[pousr]_[A-Za-z0-9]{16,}|github_pat_|sk-[A-Za-z0-9_-]{16,}|sk_(live|test)_|glpat-|xox[baprs]-|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{20,}|Bearer [A-Za-z0-9._-]{20,}' "$tmp"; then
		rm -f "$tmp"
		printf 'ERROR: a credential survived sanitising — mcp.json.example NOT written\n' >&2
		return 1
	fi

	mv -- "$tmp" "$src/mcp.json.example"
	printf '  mcp.json.example  (credentials redacted)\n'
}

case "${1:-}" in
	export)
		mkdir -p "$src"
		for f in "${FILES[@]}"; do
			[ -f "$user/$f" ] || continue
			cp "$user/$f" "$src/$f"
			printf '  %s\n' "$f"
		done
		sanitise_mcp
		if command -v code >/dev/null 2>&1; then
			code --list-extensions >"$src/extensions.txt"
		else
			# Fall back to the extensions directory. A glob rather than `ls | grep`
			# so dotfiles are skipped without tripping over odd filenames.
			(
				shopt -s nullglob
				for d in "$HOME"/.vscode/extensions/*/; do
					basename "$d" | sed -E 's/-[0-9]+\.[0-9]+\.[0-9]+.*$//'
				done
			) | sort -u >"$src/extensions.txt"
		fi
		printf '  extensions.txt    (%s extensions)\n' "$(wc -l <"$src/extensions.txt" | tr -d ' ')"

		# Refuse to leave a real token in the repo, whatever the source looked like.
		if grep -rqE 'Bearer [A-Za-z0-9._-]{20,}' "$src" 2>/dev/null; then
			printf 'ERROR: a Bearer token survived sanitising — not safe to commit\n' >&2
			exit 1
		fi
		;;
	apply)
		mkdir -p "$user"
		for f in "${FILES[@]}"; do
			[ -f "$src/$f" ] || continue
			python3 -c "import json,sys;json.load(open(sys.argv[1]))" "$src/$f" 2>/dev/null ||
				{ printf 'ERROR: %s is not valid JSON\n' "$f" >&2; exit 1; }
			cp "$src/$f" "$user/$f"
			printf '  %s -> %s\n' "$f" "${user/#$HOME/\~}"
		done
		printf 'Reload VS Code for changes to take effect.\n'
		;;
	extensions)
		[ -f "$src/extensions.txt" ] || { printf 'no extensions.txt — run export first\n' >&2; exit 1; }
		command -v code >/dev/null 2>&1 || { printf '`code` not on PATH\n' >&2; exit 1; }
		while read -r e; do
			[ -n "$e" ] && code --install-extension "$e" --force
		done <"$src/extensions.txt"
		;;
	status)
		for f in "${FILES[@]}"; do
			if [ ! -f "$src/$f" ]; then printf '  %-18s missing in repo\n' "$f"
			elif [ ! -f "$user/$f" ]; then printf '  %-18s missing on machine\n' "$f"
			elif diff -q "$src/$f" "$user/$f" >/dev/null; then printf '  %-18s in sync\n' "$f"
			else printf '  %-18s DIFFERS (%s lines)\n' "$f" "$(diff "$src/$f" "$user/$f" | grep -c '^[<>]')"
			fi
		done
		printf '  %-18s %s in repo\n' "extensions.txt" "$(wc -l <"$src/extensions.txt" 2>/dev/null | tr -d ' ' || echo 0)"
		printf '  %-18s %s\n' "mcp.json" "live file is gitignored (contains tokens)"
		;;
	-h | --help | '') usage 0 ;;
	*)
		printf 'unknown command: %s\n\n' "$1" >&2
		usage 2
		;;
esac
