#!/usr/bin/env sh
# Link this repo's zsh config into $HOME.
#
# Safe to re-run. Anything real (not already a symlink) that would be
# overwritten is moved to ~/.dotfiles-backup/<timestamp>/ first.
set -eu

# Resolve this script's own directory, so the script works no matter where the
# repo lives or which directory it is invoked from. The old version used
# $(pwd), which silently linked the wrong files when run from elsewhere.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo=$(CDPATH= cd -- "$here/.." && pwd -P)
backup="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

link() {
	src="$1"
	dst="$2"
	if [ ! -e "$src" ]; then
		printf 'skip    %s (missing in repo)\n' "$src"
		return 0
	fi
	# Move a real file/dir out of the way; replace a symlink in place.
	# -n stops ln from descending into an existing symlink-to-directory.
	if [ -e "$dst" ] && [ ! -L "$dst" ]; then
		mkdir -p "$backup"
		mv -- "$dst" "$backup/"
		printf 'backup  %s -> %s/\n' "$dst" "$backup"
	fi
	ln -sfn -- "$src" "$dst"
	printf 'link    %s -> %s\n' "$dst" "$src"
}

link "$here/.zshrc" "$HOME/.zshrc"
link "$here/.zshenv" "$HOME/.zshenv"
link "$here/.p10k.zsh" "$HOME/.p10k.zsh"
link "$here/.zsh" "$HOME/.zsh"

# Secrets live outside the repo, in a 0700 directory, as a 0600 file.
mkdir -p "$HOME/.config/zsh"
chmod 700 "$HOME/.config/zsh"
if [ ! -e "$HOME/.config/zsh/secrets.zsh" ]; then
	cp -- "$repo/.config/zsh/secrets.zsh.example" "$HOME/.config/zsh/secrets.zsh"
	chmod 600 "$HOME/.config/zsh/secrets.zsh"
	printf 'seed    %s (0600) — put your tokens here\n' "$HOME/.config/zsh/secrets.zsh"
fi

# Pick a bin dir we can actually write to. Both are on PATH per .zshrc.
# ~/bin can end up root-owned if an earlier install was run under sudo.
bindir="$HOME/.local/bin"
if [ -w "$HOME/bin" ] || { [ ! -e "$HOME/bin" ] && mkdir -p "$HOME/bin" 2>/dev/null; }; then
	bindir="$HOME/bin"
fi
mkdir -p "$bindir"
if ln -sfn -- "$here/update" "$bindir/update_zsh" 2>/dev/null; then
	printf 'link    %s -> %s\n' "$bindir/update_zsh" "$here/update"
else
	printf 'WARN    could not write %s/update_zsh (owned by another user?)\n' "$bindir"
	printf '        run updates with: %s\n' "$here/update"
fi

# An older install may have left a root-owned link pointing at the previous
# checkout. Flag it rather than silently leaving a stale updater on PATH.
for stale in "$HOME/bin/update_zsh" "$HOME/.local/bin/update_zsh"; do
	[ -L "$stale" ] || continue
	[ "$stale" = "$bindir/update_zsh" ] && continue
	printf 'WARN    stale updater on PATH: %s -> %s\n' "$stale" "$(readlink "$stale")"
	printf '        remove it with: sudo rm %s\n' "$stale"
done

printf '\nDone.\n'
[ -d "$backup" ] && printf 'Replaced files are in %s\n' "$backup"
printf 'Install missing CLI tools with:  %s/bootstrap\n' "$here"
printf 'Pull updates with:               update_zsh\n'
exit 0
