#!/usr/bin/env sh
# One-shot bootstrap: clone this repo and link its zsh config.
#
# Usage: ./auto_install [target-dir]     (default: ~/dotfiles)
set -eu

repo="${1:-$HOME/dotfiles}"

if [ -e "$repo" ]; then
	printf '%s already exists. Remove it, or pass a different target:\n' "$repo" >&2
	printf '  %s /path/to/checkout\n' "$0" >&2
	exit 1
fi

git clone --depth 1 https://github.com/Anders-planck/dotfiles.git "$repo"

# Run the installer by absolute path from the fresh clone. The old version did
# `chmod +x install && ./install` on a *relative* path after an unchecked cd,
# which could mark and execute an unrelated file in the caller's directory.
sh "$repo/zsh/install"
